# ============================================================
# TG搜索机器人 - .env 配置文件
# 版本：1.0.2+  架构：DB配置 > .env默认值 > 代码默认值
#
# 重要说明（v1.0.2+）：
#   ✅ 除 HD_WALLET_MNEMONIC 外，其它 28+ 项配置均可在后台【⚙️ 系统配置】页面修改
#      → 登录后台 → 左侧「⚙️ 系统配置」→ 填完点「💾 保存全部并生效」
#      → 保存后内存即时生效，重启服务后从 DB 读取（持久化）
#
#   🔐 HD_WALLET_MNEMONIC（HD钱包助记词）= 安全硬约束
#      → 必须手写保存在本文件 .env 中，**绝对不能录入后台**
#      → 必须离线备份（写在纸条上锁保险箱），切勿截图、存云盘、发聊天
#
# 使用方法:
#   1. 复制为 .env:  cp .env.example .env
#   2. 【至少填入】HD_WALLET_MNEMONIC + SESSION_SECRET + CRYPTO_SECRET 3 项
#   3. 其余配置先空着，等登录后台后在【⚙️ 系统配置】里填写（含 TG Bot Token、采集账号池、定价等）
#   4. 标【自动生成】的留空，部署脚本会自动填
# ============================================================

# ============================================================
# 【必填 · 可在后台【机器人配置】分组填写】TG Bot Token
# ============================================================
# 申请教程:
#   1. 在 Telegram 搜索 @BotFather
#   2. 发送 /newbot 按提示创建 Bot
#   3. 获得类似 "123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11" 的 Token
# ⚠️ Token 泄露 = 别人可以控制你的机器人！泄露后立刻在 BotFather 用 /revoke 重置
# ✅ 也可以在后台【⚙️ 系统配置】→【🤖 机器人配置】里填写后保存（加密入库）
TG_BOT_TOKEN=

# ============================================================
# 【必填 · 可在后台【🎣 采集账号池】分组填写】Telethon 采集账号池
# ============================================================
# 申请教程:
#   1. 打开 https://my.telegram.org 用手机号登录
#   2. 点击 "API development tools" 创建应用
#   3. 获得 api_id (数字) 和 api_hash (32位字符串)
# 重要:
#   - 每个手机号一组三件套 (api_id, api_hash, phone)
#   - 至少 1 个账号,推荐 3 个以上轮换防风控
#   - 三组数量必须一致,用英文逗号分隔
#
# 示例(3个账号):
#   TELETHON_API_IDS=123456,789012,345678
#   TELETHON_API_HASHS=abc123def456xxx,yyy567zzz,uuu891vvv
#   TELETHON_PHONES=+8613800001111,+8613800002222,+8613800003333
# ✅ 也可以在后台【⚙️ 系统配置】→【🎣 采集账号池】里填写后保存（api_hash 加密入库）
# 采集账号池先空：等后台填
TELETHON_API_IDS=
TELETHON_API_HASHS=
TELETHON_PHONES=

# 会话文件存储目录(不要改,除非你懂)
SESSION_DIR=./data/sessions

# ============================================================
# 【必填 · 可在后台【🤖 机器人配置】分组填写】管理员 TG ID
# ============================================================
# 获取方法: 在 TG 搜 @userinfobot 发任意消息,会返回你的 ID
# 多个管理员用英文逗号分隔
# 注意:这里填【个人账号 ID】,不是 Bot ID
# ✅ 也可以在后台【⚙️ 系统配置】→【🤖 机器人配置】里填写后保存
ADMIN_TG_IDS=

# ============================================================
# 【可在后台【⚙️ 系统与路径】分组修改】数据库路径
# ============================================================
DB_PATH=./data/tg_search.db

# ============================================================
# 【可在后台【🔍 搜索与采集风控】分组修改】采集风控参数
# ============================================================
# 单账号最大订阅频道数(TG 硬上限 500,建议留余量)
MAX_CHANNELS_PER_ACCOUNT=450
# 每次 join 频道间隔秒数(防止 TG 限制)
JOIN_INTERVAL_SECONDS=45
# 单账号每日最大 join 次数(别超 50,风险大)
MAX_JOIN_PER_DAY=40

# ============================================================
# 【可在后台【🔍 搜索与采集风控】分组修改】搜索功能配置
# ============================================================
# 单次搜索返回结果数量
SEARCH_RESULT_LIMIT=20
# 免费用户每日搜索次数限制(0=无限,防滥用)
FREE_SEARCH_DAILY_LIMIT=5

# ============================================================
# 【USDT-TRC20 钱包配置】
# ============================================================
# 所有用户充值必须走 USDT-TRC20 网络,其他网络的充值会永久丢失！

# 1. TronGrid API Key（✅ 可在后台【💰 钱包与广告定价】分组里填写，加密入库）
#    申请地址: https://www.trongrid.io/
#    注册后创建 API Key,免费版每日 10 万次请求够用
TRONGRID_API_KEY=

# 2. HD 钱包助记词(12 或 24 个单词,空格分隔)
#    生成方法(任选其一):
#      a. 命令行: python -c "from hdwallet import HDWallet; from hdwallet.symbols import TRX; w=HDWallet(TRX); w.from_mnemonic(''); print(w.mnemonic())"
#      b. 离线网页: https://iancoleman.io/bip39/ (币种选 TRON/TRX,路径 m/44'/195'/0'/0)
# 🔐 【安全硬约束 · 只能在 .env 手写！】
#    绝对不能录入后台！必须离线保存(手写纸条锁保险箱)
#    泄露 = 钱包资金 100% 被盗！不要截图,不要存云盘,不要发聊天！
HD_WALLET_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# 3. 充值确认参数（✅ 可在后台【💰 钱包与广告定价】里修改）
RECHARGE_CONFIRMATIONS=12
MIN_RECHARGE_AMOUNT=0.5

# 4. 业务定价(USDT)（✅ 可在后台【💰 钱包与广告定价】里修改）
CUSTOM_BOT_SETUP_FEE_USDT=500
MONTHLY_SUBSCRIPTION_USDT=99
QUARTERLY_SUBSCRIPTION_USDT=267
YEARLY_SUBSCRIPTION_USDT=950

# ============================================================
# 【✅ 可在后台【💰 钱包与广告定价】分组修改】广告系统配置
# ============================================================
# CPC 每次点击价格(USDT,小数)
DEFAULT_CPC_PRICE=0.01
# CPM 千次展示价格(USDT)
DEFAULT_CPM_PRICE=0.5
# 广告最低预算(USDT)
MIN_AD_BUDGET_USDT=1
# 每日最高消耗上限(0=不限)
MAX_DAILY_SPEND_USDT=0

# ============================================================
# 【自动生成 · 不要手动填】安全配置
# ============================================================
# 会话加密密钥(32 位 HEX,部署脚本自动生成)
# 用于加密管理员后台登录态 SESSION
SESSION_SECRET=

# 钱包加密密钥(32 字节 BASE64,部署脚本自动生成)
# 用于加密数据库中的敏感字段
CRYPTO_SECRET=

# ============================================================
# 日志配置(一般不用改)
# ============================================================
LOG_DIR=./logs
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ============================================================
# 版本与备份(一般不用改)
# ============================================================
# Git 仓库地址(用于一键拉取更新,可选)
VERSION_REPO_URL=
